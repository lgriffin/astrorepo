{
  "name": "astrorepo",
  "version": "0.2.0",
  "description": "Universal Astrophotography Observatory Management System",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "dist": "npm run build && electron-forge make",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fuzz": "tsx scripts/fuzz.ts",
    "lint": "eslint src/ tests/ packages/ scripts/ features/",
    "ears": "tsx scripts/ears/cli.ts",
    "test:mutation": "stryker run",
    "test:mutation:changed": "node scripts/mutation/changed.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "db:seed": "tsx src/main/db/seed/run-seed.ts",
    "db:reset": "tsx src/main/db/seed/reset-and-seed.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "{src,packages,scripts,features}/**/*.{ts,tsx}": [
      "eslint --max-warnings=0"
    ]
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "better-sqlite3": "^11.7.0",
    "electron-squirrel-startup": "^1.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.0",
    "ulid": "^2.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cucumber/cucumber-expressions": "^20.1.0",
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/messages": "^34.2.1",
    "@electron-forge/cli": "^7.6.0",
    "@electron-forge/maker-squirrel": "^7.6.0",
    "@electron-forge/maker-zip": "^7.6.0",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "~9.6.1",
    "@stryker-mutator/typescript-checker": "~9.6.1",
    "@stryker-mutator/vitest-runner": "~9.6.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "electron": "^33.4.11",
    "electron-vite": "^2.3.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
